{
    "name": "json-schema-manager",
    "version": "0.3.0",
    "description": "Angular JSON Schema form renderer with Tailwind styling, external $ref support, and reactive forms.",
    "homepage": "https://luigiellebalotta.github.io/json-schema-manager/",
    "repository": {
        "type": "git",
        "url": "https://github.com/LuigiElleBalotta/json-schema-manager.git"
    },
    "bugs": {
        "url": "https://github.com/LuigiElleBalotta/json-schema-manager/issues"
    },
    "license": "MIT",
    "author": "Luigi Elle Balotta",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build:lib": "node scripts/generate-lib-styles.mjs && ng build ng-json-schema-form",
        "publish:lib": "npm run build:lib && npm publish ./dist/ng-json-schema-form --access public",
        "watch": "ng build --watch --configuration development",
        "test": "ng test"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21.2.25",
        "@angular/compiler": "^21.2.25",
        "@angular/core": "^21.2.25",
        "@angular/forms": "^21.2.25",
        "@angular/platform-browser": "^21.2.25",
        "@angular/router": "^21.2.25",
        "ajv": "^8.17.1",
        "ajv-draft-04": "^1.0.0",
        "ajv-formats": "^3.0.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.29",
        "@angular/cli": "^21.2.29",
        "@angular/compiler-cli": "^21.2.25",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/jasmine": "~5.1.0",
        "autoprefixer": "^10.4.19",
        "axe-core": "^4.14.0",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "ng-packagr": "^21.2.7",
        "postcss": "^8.4.38",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.2"
    },
    "overrides": {
        "ip-address": "10.1.0",
        "htmlparser2": "10.1.0"
    }
}
